{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bhavesh.codes"
        }
      ],
      "destination": "https://bhavesh.codes/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Bhavesh_Kukreja_Resume.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ]
}
